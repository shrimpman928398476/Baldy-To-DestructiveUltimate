        FrameTime += DT * 60
        local NeededFrame = CinematicsModule[math.ceil(FrameTime)]

        if NeededFrame then
            TweenService:Create(Camera, TweenInfo.new(0.015, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
