            Camera.FieldOfView = NeededFrame.fov
        else
            Connection:Disconnect()
            Camera.FieldOfView = 70
            Character.Humanoid.AutoRotate = true
            Camera.CameraType = Enum.CameraType.Custom
            Camera.CFrame = CurrentCameraCFrame    
        end
    end)
