humanoid.WalkSpeed = 0
humanoid.JumpPower = 0

-- Face down (180 degrees on X)
local faceDown = CFrame.Angles(math.rad(-90), 0, 0)

-- KEEP POSITION LOCKED FOR 1 SECOND
local connection
connection = RunService.RenderStepped:Connect(function()
    -- 5 studs above closest player
    local lockPos = targetHRP.Position + Vector3.new(0, 5.5, 0)
    
    -- Apply the rotation + locked position
    hrp.CFrame = CFrame.new(lockPos) * faceDown
    
    -- Zero angular rotation
    hrp.AssemblyAngularVelocity = Vector3.zero
end)
game:GetService("Players").LocalPlayer.Character.Communicate:FireServer(unpack({
    [1] = {
        ["Tool"] = game:GetService("Players").LocalPlayer.Backpack["Normal Punch"],
        ["Goal"] = "Console Move"
    }
}))
